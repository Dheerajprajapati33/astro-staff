{
  "expo": {
    "name": "Astrologer",
    "slug": "Astrologer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "astrologer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sandeepkumar90.Astrologer",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Astrologer uses your microphone to let you dictate chat messages.",
        "NSSpeechRecognitionUsageDescription": "Astrologer uses speech recognition to convert your voice into chat messages."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sandeepkumar90.Astrologer",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "android.permission.INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-speech-recognition",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ef1d0b58-b753-4696-a324-c2f6c5949c17"
      }
    },
    "owner": "dheerajprajapati12"
  }
}
